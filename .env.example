# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional Gemini + retailer search pilot ──────────────────────────────────
# Set all three together after validating the pilot. Keep keys on the server.
# SEARCH_PROVIDER=gemini
# GEMINI_API_KEY=...
# SERPAPI_API_KEY=...

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# ── Card encryption (min 32 random chars) ────────────────────────────────────
CARD_ENCRYPT_SECRET=change-this-to-a-long-random-string-32chars

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
PUBLIC_APP_URL=https://topagent-frontend.vercel.app/
HEADLESS=true     # set false to watch browser during dev

# ── Playwright (set automatically in Docker) ─────────────────────────────────
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
